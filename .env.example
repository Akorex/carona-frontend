# Copy this file to .env and set the address of the Carona API.
# Vite only exposes variables that start with VITE_ to the browser.
# No trailing slash. Examples:
#   http://localhost:8000          (the API running on this computer)
#   http://192.168.1.20:8000       (the API on another computer on your network)
#   https://api.carona.example     (a deployed API)
VITE_API_URL=http://localhost:8000
